		aurasState = self:GetAurasState(player),
		currentMoney = self:GetMoney(player),
		diagnostics = if DIAGNOSTICS_KEY then self:Get(player, DIAGNOSTICS_KEY) else nil,
		successfulRollCount = self:GetSuccessfulRollCount(player),
	})
