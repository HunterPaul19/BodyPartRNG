	id: string,
	setId: string,
	label: string,
	sortOrder: number,
	assetModelName: string,
	iconName: string,
	bonuses: AuraBonusConfig,
}

local function withTrailingSpaces(value: string, count: number): string
	return value .. string.rep(" ", count)
end

