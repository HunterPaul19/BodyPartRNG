			ExposureCompensation = -0.22,
			Ambient = Color3.fromRGB(95, 108, 152),
			OutdoorAmbient = Color3.fromRGB(82, 96, 134),
			ColorShift_Top = Color3.fromRGB(57, 91, 166),
			ColorShift_Bottom = Color3.fromRGB(42, 71, 118),
		},
		Atmosphere = {
