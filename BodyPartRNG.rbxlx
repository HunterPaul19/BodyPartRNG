            <string name="Name">RollTypes</string>
            <string name="Source">export type RollTypeConfig = {
	id: string,
	displayName: string,
	moneyCost: number,
	luckMultiplier: number,
	bandLuckScalar: number,
	uiOrder: number,
}

local rawRollTypes: { RollTypeConfig } = {
	{
		id = "free",
		displayName = "Free",
		moneyCost = 0,
		luckMultiplier = 1.0,
		bandLuckScalar = 0.335,
		uiOrder = 1,
	},
	{
		id = "roll_2",
