{
  "name": "GameTemplate",
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$ignoreUnknownInstances": true,
      "LoadingBootstrap": {
        "$path": "src/game/ReplicatedFirst/LoadingBootstrap.client.lua"
      }
    },
    "ReplicatedStorage": {
      "Packages": {
        "$path": "src/Packages"
      },
      "Common": {
        "$path": "src/game/ReplicatedStorage/Common"
      },
      "Lists": {
        "$path": "src/game/ReplicatedStorage/Lists"
      },
      "Loader": {
        "$path": "src/game/ReplicatedStorage/Loader.lua"
      },
      "Shared": {
        "$path": "src/game/ReplicatedStorage/Shared"
      }
    },
    "ServerScriptService": {
      "Packages": {
        "$path": "src/ServerPackages"
      },
      "Start": {
        "$path": "src/game/ServerScriptService/Start.server.lua"
      },
      "Services": {
        "$path": "src/game/ServerScriptService/Services"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Start": {
          "$path": "src/game/StarterPlayer/StarterPlayerScripts/Start.client.lua"
        },
        "Controllers": {
          "$path": "src/game/StarterPlayer/StarterPlayerScripts/Controllers"
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "HoverClient": {
        "$path": "src/game/StarterGui/HoverClient"
      },
      "MainInterface": {
        "$className": "ScreenGui",
        "$ignoreUnknownInstances": true,
        "GUIController": {
          "$path": "src/game/StarterGui/MainInterface/GUIController.lua",
          "$ignoreUnknownInstances": true,
          "Init": {
            "$path": "src/game/StarterGui/MainInterface/GUIControllerInit.client.lua"
          }
        },
        "Roll": {
          "$className": "Frame",
          "$ignoreUnknownInstances": true,
          "GUIControls": {
            "$path": "src/game/StarterGui/MainInterface/Roll/GUIControls.lua"
          }
        },
        "Leaderboard": {
          "$className": "Frame",
          "$ignoreUnknownInstances": true,
          "GUIControls": {
            "$path": "src/game/StarterGui/MainInterface/Leaderboard/GUIControls.lua"
          }
        }
      }
    }
  }
}
