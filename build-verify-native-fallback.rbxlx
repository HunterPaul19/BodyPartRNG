        <string name="Name">Packages</string>
      </Properties>
      <Item class="ModuleScript" referent="86">
        <Properties>
          <string name="Name">ProfileService</string>
          <string name="Source">return require(script.Parent._Index["etheroit_profileservice@1.2.0"]["profileservice"])</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="87">
        <Properties>
          <string name="Name">ReplicaService</string>
          <string name="Source">return require(script.Parent._Index["etheroit_replicaservice@1.0.2"]["replicaservice"])</string>
        </Properties>
