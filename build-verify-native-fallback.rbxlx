			},
		},
	},
	{
		id = "progression",
		title = "Progression",
		subtitle = "Economy, profile growth, and progression checkpoints.",
		pageName = "ProgressionPage",
		sections = {
			{
				title = "Economy",
				description = "Future shortcuts for progression balancing and reward testing.",
				actions = {
