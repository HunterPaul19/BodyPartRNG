		targetValue = 500,
	},
	{
		id = "assembly_line",
		titleId = "assembly_line",
		triggerType = "successful_rolls",
		targetValue = 2500,
	},
	{
		id = "pocket_upgrade",
		titleId = "pocket_upgrade",
		triggerType = "current_money",
		targetValue = 2500,
	},
	{
		id = "well_funded",
