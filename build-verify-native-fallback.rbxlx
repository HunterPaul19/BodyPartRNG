		targetValue = 75000,
	},
	{
		id = "vault_keeper",
		titleId = "vault_keeper",
		triggerType = "current_money",
		targetValue = 2500000,
	},
	{
		id = "clocked_in",
		titleId = "clocked_in",
		triggerType = "play_time_seconds",
		targetValue = 30 * 60,
		timeUnit = "seconds",
	},
	{
		id = "still_rolling",
		titleId = "still_rolling",
		triggerType = "play_time_seconds",
		targetValue = 2 * 60 * 60,
		timeUnit = "seconds",
	},
	{
		id = "iron_session",
		titleId = "iron_session",
		triggerType = "play_time_seconds",
		targetValue = 10 * 60 * 60,
		timeUnit = "seconds",
	},
	{
		id = "patch_collector",
		titleId = "patch_collector",
		triggerType = "new_discovered_pieces",
		targetValue = 10,
	},
	{
		id = "body_archivist",
		titleId = "body_archivist",
		triggerType = "new_discovered_pieces",
		targetValue = 30,
	},
	{
