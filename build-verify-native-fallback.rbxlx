            <string name="Name">DayNightCycleConfig</string>
            <string name="Source">local DayNightCycleConfig = {}

DayNightCycleConfig.LoopDurationSeconds = 12 * 60
DayNightCycleConfig.InitialNormalizedTime = 0.28

DayNightCycleConfig.Keyframes = {
	{
		Phase = "SUNRISE",
		LabelText = "SUNRISE",
		NormalizedTime = 0.00,
		ClockTime = 5.25,
